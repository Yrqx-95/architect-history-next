{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archistory.local/schemas/graduation/case.schema.json",
  "title": "Graduation Case",
  "type": "object",
  "required": [
    "id",
    "name",
    "location",
    "image_url",
    "plan_url",
    "section_url",
    "concept",
    "keywords",
    "source_url",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CASE-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name_ja": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name_en": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "location_ja": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "location_en": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "image_url": {
      "$ref": "#/definitions/localPathOrUrl"
    },
    "image_source_url": {
      "type": "string",
      "format": "uri"
    },
    "image_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "image_credit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "image_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "plan_url": {
      "$ref": "#/definitions/emptyOrLocalPathOrUrl"
    },
    "section_url": {
      "$ref": "#/definitions/emptyOrLocalPathOrUrl"
    },
    "concept": {
      "type": "string",
      "minLength": 10,
      "maxLength": 100
    },
    "concept_ja": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "concept_en": {
      "type": "string",
      "minLength": 10,
      "maxLength": 320
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "keywords_ja": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "keywords_en": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "year": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        {
          "type": "null"
        },
        {
          "const": ""
        }
      ]
    },
    "architect": {
      "type": "string",
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    }
  },
  "definitions": {
    "localPathOrUrl": {
      "type": "string",
      "pattern": "^(https?://|/).+"
    },
    "emptyOrLocalPathOrUrl": {
      "type": "string",
      "pattern": "^(|https?://|/).*$"
    }
  },
  "additionalProperties": false
}
