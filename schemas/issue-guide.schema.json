{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archistory.local/schemas/graduation/issue-guide.schema.json",
  "title": "Graduation Issue Guide",
  "type": "object",
  "required": [
    "issue_id",
    "social_context",
    "why_architecture",
    "spatial_problem",
    "architecture_can_do",
    "architecture_cannot_do",
    "site_clues",
    "starter_questions",
    "evidence_urls"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "pattern": "^ISSUE-[0-9]{3}$"
    },
    "social_context": {
      "$ref": "#/definitions/localizedText"
    },
    "why_architecture": {
      "$ref": "#/definitions/localizedText"
    },
    "spatial_problem": {
      "$ref": "#/definitions/localizedText"
    },
    "architecture_can_do": {
      "$ref": "#/definitions/localizedList"
    },
    "architecture_cannot_do": {
      "$ref": "#/definitions/localizedText"
    },
    "site_clues": {
      "$ref": "#/definitions/localizedList"
    },
    "starter_questions": {
      "$ref": "#/definitions/localizedList"
    },
    "evidence_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "localizedText": {
      "type": "object",
      "required": ["zh"],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 20
        },
        "ja": {
          "type": "string",
          "minLength": 20
        },
        "en": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "localizedList": {
      "type": "object",
      "required": ["zh"],
      "properties": {
        "zh": {
          "$ref": "#/definitions/textList"
        },
        "ja": {
          "$ref": "#/definitions/textList"
        },
        "en": {
          "$ref": "#/definitions/textList"
        }
      },
      "additionalProperties": false
    },
    "textList": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 4
      },
      "uniqueItems": true
    }
  }
}
