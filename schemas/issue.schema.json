{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archistory.local/schemas/graduation/issue.schema.json",
  "title": "Graduation Issue",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "keywords",
    "recommended_site_types",
    "recommended_building_types",
    "reference_case_ids",
    "source_urls",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ISSUE-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40
    },
    "title_ja": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "title_en": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 140
    },
    "summary_ja": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "summary_en": {
      "type": "string",
      "minLength": 20,
      "maxLength": 420
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "keywords_ja": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "keywords_en": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recommended_site_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SITE-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "recommended_building_types_ja": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recommended_building_types_en": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recommended_building_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reference_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CASE-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "case_relation_notes": {
      "type": "object",
      "description": "Optional adopted extension: CASE id to short explanation of why the case relates to this issue.",
      "propertyNames": {
        "pattern": "^CASE-[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "case_relation_notes_ja": {
      "type": "object",
      "propertyNames": {
        "pattern": "^CASE-[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "case_relation_notes_en": {
      "type": "object",
      "propertyNames": {
        "pattern": "^CASE-[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
